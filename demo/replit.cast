[0.016, "o", "\r\n\u001b[38;5;174m ▐\u001b[48;5;16m▛███▜\u001b[49m▌\u001b[3C\u001b[39m\u001b[1mClaude Code\u001b[C\u001b(B\u001b[m\u001b[38;5;246mv2.1.220\r\n\u001b(B\u001b[m\u001b[38;5;174m▝▜\u001b[48;5;16m█████\u001b[49m▛▘\u001b[2C\u001b(B\u001b[m\u001b[38;5;246mSonnet 5 · Claude API\r\n\u001b(B\u001b[m\u001b[38;5;174m  ▘▘ ▝▝  \u001b[2C\u001b(B\u001b[m\u001b[38;5;246m~/work/payments-api\u001b[26;89H● high · /effort\r\n\u001b(B\u001b[m\u001b[38;5;244m─────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[28;1H\u001b[39m❯ \u001b[2mTry \"edit <filepath> to...\"\r\n\u001b(B\u001b[m\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "─\u001b[29;3H\u001b(B\u001b[m\n\u001b[38;5;246m⏸ manual mode on · ? for shortcuts · ← for agents\u001b[28;3H\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[2.262, "o", "\u001b[?25l\u001b[H\u001b[K\u001b[38;5;174m\r\n ▐\u001b[48;5;16m▛███▜\u001b[49m▌\u001b[39m   \u001b[1mClaude Code\u001b(B\u001b[m \u001b[38;5;246mv2.1.220\u001b[39m\u001b[K\u001b[38;5;174m\r\n▝▜\u001b[48;5;16m█████\u001b[49m▛▘\u001b[39m  \u001b[38;5;246mSonnet 5 · Claude API\u001b[39m\u001b[K\u001b[38;5;174m\r\n  ▘▘ ▝▝\u001b[39m    \u001b[38;5;246m~/work/payments-api\u001b[39m\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[26;88H\u001b[1K\u001b[38;5;246m\u001b[C● high · /effort\u001b[39m \u001b[38;5;244m\u001b[27;1H─────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[28;1H❯ t\u001b[K\u001b[38;5;244m\r\n────────────────────────────────────────────────────────────────────"]
[0.000, "o", "─────────────────────────────────────\u001b[39m\u001b[30;1H  \u001b[38;5;246m⏸ manual mode on\u001b[39m\u001b[K\u001b[?12l\u001b[?25h\u001b[28;4H"]
[0.069, "o", "\u001b[?25l\u001b[H\u001b[K\u001b[38;5;174m\r\n ▐\u001b[48;5;16m▛███▜\u001b[49m▌\u001b[39m   \u001b[1mClaude Code\u001b(B\u001b[m \u001b[38;5;246mv2.1.220\u001b[39m\u001b[K\u001b[38;5;174m\r\n▝▜\u001b[48;5;16m█████\u001b[49m▛▘\u001b[39m  \u001b[38;5;246mSonnet 5 · Claude API\u001b[39m\u001b[K\u001b[38;5;174m\r\n  ▘▘ ▝▝\u001b[39m    \u001b[38;5;246m~/work/payments-api\u001b[39m\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[26;88H\u001b[1K\u001b[38;5;246m\u001b[C● high · /effort\u001b[39m \u001b[38;5;244m\u001b[27;1H─────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[28;1H❯ th\u001b[K\u001b[38;5;244m\r\n───────────────────────────────────────────────────────────────────"]
