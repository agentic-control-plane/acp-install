[0.003, "o", "\n\u001b[A{\r\n  \"_comment\": \"Local ACP policy \u001b[K— edit freely. decide.mjs walks keys most-specific →\r\n\u001b[29;85H least (e.g. Bash.curl.api.github.com \u001b[K→ Bash.curl →\r\u001b[12S\u001b[18;31H Bash). Values: allow | ask | deny. The safety floor (rm -rf /, mkfs, dd of a disk, fork bombs, force-push to main) always denies regardless of this file. 'default' applies when no rule matches.\",\u001b[K\r\n  \"default\": \"allow\",\u001b[K\r\n  \"rules\": {\u001b[K\r\n    \"Bash.rm\": \"ask\",\u001b[K\r\n    \"Bash.curl\": \"ask\",\u001b[K\r\n    \"Bash.git.push\": \"ask\",\u001b[K\r\n    \"Bash.chmod\": \"ask\",\u001b[K\r\n    \"Bash.chown\": \"ask\"\u001b[K\r\n  }\u001b[K\r\n}\u001b[K\r\n\u001b[K"]
