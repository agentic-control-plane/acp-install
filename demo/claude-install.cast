[0.001, "o", "\u001b[?25l\u001b[H\u001b[K\u001b[2m\r\n~/work/payments-api\u001b(B\u001b[m $ ls -1 ~/.acp/\u001b[K\r\ndecide.mjs\u001b[K\r\ngovern.mjs\u001b[K\r\npolicy.json\u001b[K\u001b[2m\r\n~/work/payments-api\u001b(B\u001b[m $ cat ~/.acp/policy.json\u001b[K\r\n{\u001b[K\r\n  \"_comment\": \"Local ACP policy — edit freely. decide.mjs walks keys most-specific → least (e.g. Bash.curl.api.github.com → Bash.curl → Bash). Values: allow | ask | deny. The safety floor (rm -rf /, mkfs, dd of a disk, fork bombs, force-push to main) always denies regardless of this file. 'default' applies when no rule matches.\",\u001b[K\r\n  \"default\": \"allow\",\u001b[K\r\n  \"rules\": {\u001b[K\r\n    \"Bash.rm\": \"ask\",\u001b[K\r\n    \"Bash.curl\": \"ask\",\u001b[K\r\n    \"Bash.git.push\": \"ask\",\u001b[K\r\n    \"Bash.chmod\": \"ask\",\u001b[K\r\n    \"Bash.chown\": \"ask\"\u001b[K\r\n  }\u001b[K\r\n}\u001b[K\u001b[2m\r\n~/work/payments-api\u001b(B\u001b[m $ grep -A2 govern.mjs ~/.claude/settings.json | head -n 8\u001b[K\u001b[22;12H\u001b[1K\u001b[C\"command\": \"env ACP_CLIENT=claude-code-plugin node $HOME/.acp/govern.mjs\",\u001b[K\u001b[23;12H\u001b[1K\u001b[C\"timeout\": 5\u001b[K\u001b[24;10H\u001b[1K\u001b[C}\u001b[K\r\n--\u001b[K\u001b[26;12H\u001b[1K\u001b[C\"command\": \"env ACP_CLIENT=claude-code-plugin node $"]
