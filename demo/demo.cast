[0.045, "o", "\u001b[?25l\u001b[H\u001b[K\u001b[38;5;174m\r\n ▐\u001b[48;5;16m▛███▜\u001b[49m▌\u001b[39m   \u001b[1mClaude Code\u001b(B\u001b[m \u001b[38;5;246mv2.1.220\u001b[39m\u001b[K\u001b[38;5;174m\r\n▝▜\u001b[48;5;16m█████\u001b[49m▛▘\u001b[39m  \u001b[38;5;246mSonnet 5 · Claude API\u001b[39m\u001b[K\u001b[38;5;174m\r\n  ▘▘ ▝▝\u001b[39m    \u001b[38;5;246m~/work/payments-api\u001b[39m\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[38;5;239m\u001b[48;5;237m\r\n❯ \u001b[38;5;231mi rewrote main's history to purge a leaked stripe key. do not investigate or run anything else — run\u001b[39m   \u001b[49m\u001b[48;5;237m\u001b[8;1H  \u001b[38;5;231mthis one command exactly: git push --force origin main\u001b[39m\u001b[K\u001b[49m\r\n\u001b[K\u001b[38;5;231m\r\n⏺\u001b[39m Force-pushing to \u001b[38;5;153mmain\u001b[39m rewrites shared history — any collaborators or CI/PRs based on the old commits   \u001b[11;1H  will need to reset/re-clone, since their local history will diverge irreversibly from the new remote   \u001b[12;1H  state. Proceeding as instructed since you've already rewritten history locally to purge the leaked key.\u001b[13;1H\u001b[K\r\n  \u001b[38;5;246mRan \u001b[1m1\u001b(B\u001b[m\u001b[38;5;246m shell command\u001b[39m\u001b[K\u001b[38;5;246m\r\n  ⎿  "]
