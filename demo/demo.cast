[0.015, "o", "\r\n\u001b[38;5;174m ▐\u001b[48;5;16m▛███▜\u001b[49m▌\u001b[3C\u001b[39m\u001b[1mClaude Code\u001b[C\u001b(B\u001b[m\u001b[38;5;246mv2.1.220\r\n\u001b(B\u001b[m\u001b[38;5;174m▝▜\u001b[48;5;16m█████\u001b[49m▛▘\u001b[2C\u001b(B\u001b[m\u001b[38;5;246mSonnet 5 · Claude API\r\n\u001b(B\u001b[m\u001b[38;5;174m  ▘▘ ▝▝  \u001b[2C\u001b(B\u001b[m\u001b[38;5;246m~/work/payments-api\u001b[26;89H● high · /effort\r\n\u001b(B\u001b[m\u001b[38;5;244m─────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[28;1H\u001b[39m❯ \u001b[2mTry \"edit <filepath> to...\"\r\n\u001b(B\u001b[m\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────"]
