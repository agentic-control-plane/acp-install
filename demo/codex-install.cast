[0.000, "o", "\u001b[48;5;238m\u001b[H \u001b[K\u001b[49m\u001b[48;5;238m\r\n  \u001b[1mHooks need review\u001b(B\u001b[m\u001b[48;5;238m\u001b[K\u001b[49m\u001b[48;5;238m\r\n  \u001b[33m2 hooks are new or changed.\u001b[39m\u001b[K\u001b[49m\u001b[48;5;238m\r\n  \u001b[2mHooks can run outside the sandbox after you trust them.\u001b(B\u001b[m\u001b[48;5;238m\u001b[K\u001b[49m\u001b[48;5;238m\r\n \u001b[K\u001b[49m\u001b[36m\u001b[48;5;238m\u001b[1m\r\n› 1. Review hooks\u001b(B\u001b[m\u001b[48;5;238m\u001b[K\u001b[49m\u001b[48;5;238m\r\n  2. Trust all and continue\u001b[K\u001b[49m\u001b[48;5;238m\r\n  3. Continue without trusting (hooks won't run)\u001b[K\u001b[49m\u001b[48;5;238m\r\n \u001b[K\u001b[49m\r\n  \u001b[2mPress enter to confirm or esc to go back                                                               \u001b(B\u001b[m\u001b[11;1H\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[10;105H"]
