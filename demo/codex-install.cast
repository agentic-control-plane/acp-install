[0.000, "o", "\u001b[H\u001b[K\u001b[2m\r\n╭───────────────────────────────────────╮\u001b(B\u001b[m\u001b[K\u001b[2m\r\n│ >_ \u001b(B\u001b[m\u001b[1mOpenAI Codex\u001b(B\u001b[m\u001b[2m (v0.147.0)            │\u001b(B\u001b[m\u001b[K\u001b[2m\r\n│                                       │\u001b(B\u001b[m\u001b[K\u001b[2m\r\n│ model:     \u001b[3mloading\u001b(B\u001b[m\u001b[2m   \u001b(B\u001b[m\u001b[36m/model\u001b[39m\u001b[2m to change │\u001b(B\u001b[m\u001b[K\u001b[2m\r\n│ directory: \u001b(B\u001b[m~/work/payments-api\u001b[2m        │\u001b(B\u001b[m\u001b[K\u001b[2m\r\n╰───────────────────────────────────────╯\u001b(B\u001b[m\u001b[K\r\n\u001b[K\u001b[48;5;238m\r\n \u001b[K\u001b[49m\u001b[48;5;238m\r\n  \u001b[1mHooks\u001b(B\u001b[m\u001b[48;5;238m\u001b[K\u001b[49m\u001b[48;5;238m\r\n  \u001b[2mLifecycle hooks from config and enabled plugins.\u001b(B\u001b[m\u001b[48;5;238m\u001b[K\u001b[49m\u001b[48;5;238m\r\n \u001b[K\u001b[49m\u001b[48;5;238m\r\n  \u001b[33m⚠ 2 hooks need review before they can run.\u001b[39m\u001b[K\u001b[49m\u001b[48;5;238m\r\n \u001b[K\u001b[49m\u001b[48;5;238m\r\n  Event\u001b[17X\u001b[17CInstalled   Active      Review      Description\u001b[K\u001b[49m\u001b[48;5;238m\r\n  \u001b[36m\u001b[1mPreToolUse            1           0     "]
