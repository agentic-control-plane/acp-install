[0.086, "o", "\u001b[?25l\u001b[H\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[?12l\u001b[?25h\u001b[H\u001b[?25l\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1006h\u001b[?1000h\u001b[?1002h\u001b[?1003h"]
[0.022, "o", "\r\n\u001b[38;5;174m ▐\u001b[48;5;16m▛███▛█\u001b[3C\u001b[39m\u001b[49m\u001b[1mClaude Code\u001b[C\u001b(B\u001b[m\u001b[38;5;246mv2.1.238\r\n\u001b(B\u001b[m\u001b[38;5;174m▝▜\u001b[48;5;16m█████\u001b[49m█▀\u001b[2C\u001b(B\u001b[m\u001b[38;5;246mSonnet 5 · Claude API\r\n\u001b(B\u001b[m\u001b[38;5;174m  ▝▝ ▝▝  \u001b[2C\u001b(B\u001b[m\u001b[38;5;246m~/work/payments-api\u001b[6;2H\u001b(B\u001b[m\u001b[38;5;174m▎\u001b[CFable 5 is now a standard part of your Max plan\u001b[7;2H▎\u001b[C\u001b[39mYou\u001b[Ccan\u001b[Cuse\u001b[Cup\u001b[Cto\u001b[C50%\u001b[Cof\u001b[Cyour\u001b[Cweekly\u001b[Cusage\u001b[Climit\u001b[Con\u001b[CFable\u001b[C5.\u001b[CIf\u001b[Cyou\u001b[Chit\u001b[Cyour\u001b[Climit,\u001b[Cyou\u001b[Ccan\u001b[Ccontinue\u001b[8;2H\u001b[38;5;174m▎\u001b[C\u001b[39mon\u001b[CFable\u001b[C5\u001b[Cwith\u001b[Cusage\u001b[Ccredits.\u001b[CFable\u001b[C5\u001b[Cdraws\u001b[Cdown\u001b[Cusage\u001b[Cfaster\u001b[Cthan\u001b[COpus\u001b[C5.\u001b[CRun\u001b[C/model\u001b[Cand\u001b[Cselect\u001b[9;2H\u001b[38;5;174m▎\u001b[C\u001b[39mFable\u001b[Cto\u001b[Cuse\u001b[Cit.\u001b[CLearn\u001b[Cmore:\u001b[10;2H\u001b[38;5;174m▎\u001b[C\u001b[39mhttps://support.claude.com/en/articles/15424964-claude-fable-5-promotional-access\u001b[26;88H\u001b[38;5;246m● high · /effort\r\n\u001b(B\u001b[m\u001b[38;5;244m───────\u001b(B\u001b[m\u001b[38;5;244m─────────────────────────"]
[0.000, "o", "─────────────────────────────────────────────────────────────────────────\u001b[28;1H\u001b[39m❯ \u001b[2mTry \"how do I log an error?\"\r\n\u001b(B\u001b[m\u001b[38;5;244m─────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[30;3H\u001b(B\u001b[m\u001b[38;5;246m⏸ manual mode on · ? for shortcuts · ← for agents\u001b[28;3H\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[0.025, "o", "\u001b[?25l\u001b[H\u001b[K\u001b[38;5;174m\r\n ▐\u001b[48;5;16m▛███▛█\u001b[39m\u001b[49m   \u001b[1mClaude Code\u001b(B\u001b[m \u001b[38;5;246mv2.1.238\u001b[39m\u001b[K\u001b[38;5;174m\r\n▝▜\u001b[48;5;16m█████\u001b[49m█▀\u001b[39m  \u001b[38;5;246mSonnet 5 · Claude API\u001b[39m\u001b[K\u001b[38;5;174m\r\n  ▝▝ ▝▝\u001b[39m    \u001b[38;5;246m~/work/payments-api\u001b[39m\u001b[K\r\n\u001b[K\r\n \u001b[38;5;174m▎\u001b[39m \u001b[38;5;174mFable 5 is now a standard part of your Max plan\u001b[39m\u001b[K\r\n \u001b[38;5;174m▎\u001b[39m You can use up to 50% of your weekly usage limit on Fable 5. If you hit your limit, you can continue  \u001b[8;1H \u001b[38;5;174m▎\u001b[39m on Fable 5 with usage credits. Fable 5 draws down usage faster than Opus 5. Run /model and select     \u001b[9;1H \u001b[38;5;174m▎\u001b[39m Fable to use it. Learn more:\u001b[K\r\n \u001b[38;5;174m▎\u001b[39m https://support.claude.com/en/articles/15424964-claude-fable-5-promotional-access\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[26;87H\u001b[1K\u001b[38;5;246m\u001b[C● high · /effort\u001b[39m  \u001b[38;5;244m\u001b[27;1H───────────────────────"]
[0.000, "o", "──────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[28;1H❯ \u001b[K\u001b[38;5;244m\r\n─────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[30;1H  \u001b[38;5;246m⏸ manual mode on · ? for shortcuts · ← for agents\u001b[39m\u001b[K\u001b[?12l\u001b[?25h\u001b[28;3H"]
