[0.021, "o", "\r\n\u001b[38;5;174m╭───\u001b[CClaude Code\u001b[C\u001b(B\u001b[m\u001b[38;5;246mv2.1.238\u001b[C\u001b(B\u001b[m\u001b[38;5;174m──────────────────────────────────────────────────────────────────────────────╮\u001b[3;1H│\u001b[27C\u001b[2m│\u001b[C\u001b(B\u001b[m\u001b[38;5;174m\u001b[1mWhat's new\u001b[64C\u001b(B\u001b[m\u001b[38;5;174m│\u001b[4;1H│\u001b[7C\u001b[39m\u001b[1mWelcome back!\u001b[7C\u001b(B\u001b[m\u001b[38;5;174m\u001b[2m│\u001b[C\u001b(B\u001b[mAdded\u001b[Ca\u001b[C`keybindingFlavor`\u001b[Csetting:\u001b[Cset\u001b[Cit\u001b[Cto\u001b[C`\"readline\"`\u001b[Cto\u001b[Cmake\u001b[CCtrl+…\u001b[C\u001b[38;5;174m│\u001b[5;1H│\u001b[27C\u001b[2m│\u001b[C\u001b(B\u001b[mPlugin\u001b[Cmarketplaces:\u001b[C`headersHelper`\u001b[Con\u001b[Ca\u001b[Curl\u001b[Cmarketplace\u001b[Cor\u001b[Ca\u001b[Ccatalog\u001b[Ce…\u001b[C\u001b[38;5;174m│\u001b[6;1H│\u001b[9C ▐\u001b[48;5;16m▛███▛█\u001b[10C\u001b[49m\u001b[2m│\u001b[C\u001b(B\u001b[mA\u001b[Ccatalog\u001b[Centry's\u001b[C`headersHelper`\u001b[Cruns\u001b[Conly\u001b[Cwhen\u001b[Cyou\u001b[Cinstall\u001b[Cor\u001b[Cupdate\u001b[Ct…\u001b[C\u001b[38;5;174m│\u001b[7;1H│\u001b[9C▝▜\u001b[48;5;16m████\u001b(B\u001b[m\u001b[38;5;174m\u001b[48;5;16m█\u001b[49m█▀\u001b[9C\u001b[2m│\u001b[C\u001b(B\u001b[m\u001b[38;5;"]
[0.000, "o", "246m\u001b[3m/release-notes for more\u001b[51C\u001b(B\u001b[m\u001b[38;5;174m│\u001b[8;1H│\u001b[9C  ▝▝ ▝▝  \u001b[9C\u001b[2m│\u001b[75C\u001b(B\u001b[m\u001b[38;5;174m│\u001b[9;1H│\u001b[27C\u001b[2m│\u001b[75C\u001b(B\u001b[m\u001b[38;5;174m│\u001b[10;1H│\u001b[3C\u001b(B\u001b[m\u001b[38;5;246mSonnet 5 · Claude API\u001b[3C\u001b(B\u001b[m\u001b[38;5;174m\u001b[2m│\u001b[75C\u001b(B\u001b[m\u001b[38;5;174m│\u001b[11;1H│\u001b[4C\u001b(B\u001b[m\u001b[38;5;246m~/work/payments-api\u001b[4C\u001b(B\u001b[m\u001b[38;5;174m\u001b[2m│\u001b[75C\u001b(B\u001b[m\u001b[38;5;174m│\u001b[12;1H╰───────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[26;88H\u001b(B\u001b[m\u001b[38;5;246m● high · /effort\r\n\u001b(B\u001b[m\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "────────────\u001b(B\u001b[m\u001b[38;5;244m──────\u001b[28;1H\u001b[39m❯ \u001b[2mTry \"write a test for <filepath>\"\r\n\u001b(B\u001b[m\u001b[38;5;244m─────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[30;3H\u001b(B\u001b[m\u001b[38;5;246m⏸ manual mode on · ? for shortcuts · ← for agents\u001b[28;3H\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[0.033, "o", "\u001b[?25l\u001b[H\u001b[K\u001b[38;5;174m\r\n╭───\u001b[39m \u001b[38;5;174mClaude Code\u001b[39m \u001b[38;5;246mv2.1.238\u001b[39m \u001b[38;5;174m──────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[38;5;174m\u001b[3;1H│\u001b[39m\u001b[27X\u001b[38;5;174m\u001b[2m\u001b[27C│\u001b(B\u001b[m \u001b[38;5;174m\u001b[1mWhat's new\u001b(B\u001b[m\u001b[64X\u001b[38;5;174m\u001b[64C│\u001b[39m\u001b[38;5;174m\u001b[4;1H│\u001b[39m       \u001b[1mWelcome back!\u001b(B\u001b[m       \u001b[38;5;174m\u001b[2m│\u001b(B\u001b[m Added a `keybindingFlavor` setting: set it to `\"readline\"` to make Ctrl+… \u001b[38;5;174m│\u001b[39m\u001b[38;5;174m\u001b[5;1H│\u001b[39m\u001b[27X\u001b[38;5;174m\u001b[2m\u001b[27C│\u001b(B\u001b[m Plugin marketplaces: `headersHelper` on a url marketplace or a catalog e… \u001b[38;5;174m│\u001b[39m\u001b[38;5;174m\u001b[6;1H│\u001b[10X\u001b[10C▐\u001b[48;5;16m▛███▛█\u001b[39m\u001b[49m          \u001b[38;5;174m\u001b[2m│\u001b(B\u001b[m A catalog entry's `headersHelper` runs only when you install or update t… \u001b[38;5;174m│\u001b[39m\u001b[38;5;174m\u001b[7;1H"]
